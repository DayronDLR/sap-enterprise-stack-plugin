{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sap-diagrams/landscape.schema.json",
  "title": "SAP Solution Diagram — landscape y ruta de transportes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_type", "meta", "systems"],
  "properties": {
    "schema_version": { "const": 1 },
    "diagram_type": { "const": "landscape" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 90 },
        "subtitle": { "type": "string", "maxLength": 120 },
        "quality_profile": { "$ref": "common.schema.json#/$defs/qualityProfile" }
      }
    },
    "systems": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sid", "role", "clients"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "sid": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{2}$" },
          "role": { "$ref": "common.schema.json#/$defs/systemRole" },
          "label": { "type": "string", "maxLength": 40 },
          "type": { "$ref": "common.schema.json#/$defs/nodeType" },
          "clients": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "mandt", "label"],
              "properties": {
                "id": { "$ref": "common.schema.json#/$defs/id" },
                "mandt": { "type": "string", "pattern": "^[0-9]{3}$" },
                "label": { "type": "string", "minLength": 1, "maxLength": 30 },
                "sublabel": { "type": "string", "maxLength": 30 }
              }
            }
          }
        }
      }
    },
    "transports": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "from": { "$ref": "common.schema.json#/$defs/id" },
          "to": { "$ref": "common.schema.json#/$defs/id" },
          "label": { "type": "string", "maxLength": 28 },
          "kind": { "$ref": "common.schema.json#/$defs/transportKind" },
          "style": { "$ref": "common.schema.json#/$defs/edgeStyle" }
        }
      }
    }
  }
}
