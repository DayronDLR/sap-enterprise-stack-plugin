{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sap-diagrams/sequence.schema.json",
  "title": "SAP Solution Diagram — secuencia",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_type", "meta", "participants", "messages"],
  "properties": {
    "schema_version": { "const": 1 },
    "diagram_type": { "const": "sequence" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 90 },
        "subtitle": { "type": "string", "maxLength": 120 },
        "quality_profile": { "$ref": "common.schema.json#/$defs/qualityProfile" }
      }
    },
    "participants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "type": { "$ref": "common.schema.json#/$defs/nodeType" },
          "label": { "type": "string", "minLength": 1, "maxLength": 26 },
          "sublabel": { "type": "string", "maxLength": 26 }
        }
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "label"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "from": { "$ref": "common.schema.json#/$defs/id" },
          "to": { "$ref": "common.schema.json#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 46 },
          "kind": { "$ref": "common.schema.json#/$defs/edgeKind" },
          "style": { "$ref": "common.schema.json#/$defs/edgeStyle" },
          "return": { "type": "boolean" },
          "note": { "type": "string", "maxLength": 60 }
        }
      }
    }
  }
}
