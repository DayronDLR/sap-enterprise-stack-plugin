{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "mcp": {
    "sap-cap-capire": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@cap-js/mcp-server@0.0.5"
      ],
      "enabled": true
    },
    "sap-ui5": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@ui5/mcp-server@0.2.14"
      ],
      "enabled": true
    },
    "sap-fiori-tools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@sap-ux/fiori-mcp-server@1.7.1",
        "fiori-mcp"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github@2025.4.8"
      ],
      "enabled": true
    },
    "sap-adt": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mcp-abap-adt/core@7.2.1"
      ],
      "enabled": true,
      "environment": {
        "SAP_ADT_URL": "${SAP_ADT_URL}",
        "SAP_ADT_USER": "${SAP_ADT_USER}",
        "SAP_ADT_PASSWORD": "${SAP_ADT_PASSWORD}",
        "SAP_ADT_CLIENT": "${SAP_ADT_CLIENT}",
        "SAP_ADT_LANG": "${SAP_ADT_LANG:-EN}"
      }
    }
  }
}
