{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "mcp": {
    "sap-cap-capire": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@cap-js/mcp-server@0.0.6"
      ],
      "enabled": true
    },
    "sap-ui5": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@ui5/mcp-server@0.3.1"
      ],
      "enabled": true
    },
    "sap-fiori-tools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@sap-ux/fiori-mcp-server@1.15.0",
        "fiori-mcp"
      ],
      "enabled": true
    },
    "sap-adt": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mcp-abap-adt/core@7.2.1",
        "--exposition=readonly"
      ],
      "enabled": true,
      "environment": {
        "MCP_ENV_PATH": "${SAP_ADT_ENV_PATH:-/dev/null}",
        "SAP_SYSTEM_TYPE": "${SAP_ADT_SYSTEM_TYPE:-onprem}"
      }
    }
  }
}
