{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sap-diagrams/integration.schema.json",
  "title": "SAP Solution Diagram — integración (iFlow)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_type", "meta", "lanes", "steps"],
  "properties": {
    "schema_version": { "const": 1 },
    "diagram_type": { "const": "integration" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 90 },
        "subtitle": { "type": "string", "maxLength": 120 },
        "package": { "type": "string", "maxLength": 60 },
        "quality_profile": { "$ref": "common.schema.json#/$defs/qualityProfile" }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "kind": { "enum": ["sender", "process", "local-process", "exception", "receiver"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 48 },
          "sublabel": { "type": "string", "maxLength": 48 }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label", "lane"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "type": { "$ref": "common.schema.json#/$defs/stepType" },
          "label": { "type": "string", "minLength": 1, "maxLength": 34 },
          "sublabel": { "type": "string", "maxLength": 34 },
          "lane": { "$ref": "common.schema.json#/$defs/id" },
          "layer": { "type": "integer", "minimum": 0, "maximum": 9 },
          "order": { "type": "integer", "minimum": 0, "maximum": 99 }
        }
      }
    },
    "flows": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "from": { "$ref": "common.schema.json#/$defs/id" },
          "to": { "$ref": "common.schema.json#/$defs/id" },
          "label": { "type": "string", "maxLength": 28 },
          "protocol": { "$ref": "common.schema.json#/$defs/protocol" },
          "kind": { "$ref": "common.schema.json#/$defs/edgeKind" },
          "style": { "$ref": "common.schema.json#/$defs/edgeStyle" },
          "condition": { "type": "string", "maxLength": 28 },
          "bidirectional": { "type": "boolean" }
        }
      }
    }
  }
}
