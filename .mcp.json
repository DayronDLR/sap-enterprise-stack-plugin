{
  "mcpServers": {
    "sap-cap-capire": {
      "command": "npx",
      "args": [
        "-y",
        "@cap-js/mcp-server@0.0.6"
      ],
      "env": {}
    },
    "sap-ui5": {
      "command": "npx",
      "args": [
        "-y",
        "@ui5/mcp-server@0.3.1"
      ],
      "env": {}
    },
    "sap-fiori-tools": {
      "command": "npx",
      "args": [
        "-y",
        "@sap-ux/fiori-mcp-server@1.15.0",
        "fiori-mcp"
      ],
      "env": {}
    },
    "sap-adt": {
      "command": "npx",
      "args": [
        "-y",
        "@mcp-abap-adt/core@7.2.1",
        "--exposition=readonly"
      ],
      "env": {
        "MCP_ENV_PATH": "${SAP_ADT_ENV_PATH:-/dev/null}",
        "SAP_SYSTEM_TYPE": "${SAP_ADT_SYSTEM_TYPE:-onprem}"
      }
    }
  }
}
